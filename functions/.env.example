# Stripe Configuration for Local Development
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp functions/.env.example functions/.env
# 2. Replace the placeholder values below with your TEST keys from Stripe Dashboard
# 3. Never commit functions/.env to git (it's gitignored for security)
#
# For production deployment:
# - Use Firebase secrets instead of .env file
# - Set secrets with: firebase functions:secrets:set STRIPE_SECRET_KEY
# - Set secrets with: firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Stripe Secret Key (use TEST key: sk_test_...)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (use TEST secret: whsec_...)
# Get from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
