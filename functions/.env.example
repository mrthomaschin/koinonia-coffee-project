# Stripe Configuration for Local Development
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp functions/.env.example functions/.env
# 2. Replace the placeholder values below with your TEST keys from Stripe Dashboard
# 3. Never commit functions/.env to git (it's gitignored for security)
#
# For production deployment:
# - Use Firebase secrets instead of .env file
# - Set secrets with: firebase functions:secrets:set STRIPE_SECRET_KEY
# - Set secrets with: firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Stripe Secret Key (use TEST key: sk_test_...)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (use TEST secret: whsec_...)
# Get from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Notion Configuration
# Get from: https://www.notion.so/my-integrations
# 1. Create an internal integration and copy the token (starts with secret_)
# 2. Share your database with the integration
# 3. Copy the database ID from the database URL (32-character string)
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_ONLINE_ORDERS_DATABASE_ID=your_database_id_here

# EmailJS Configuration for Automated Notifications
# Get from: https://dashboard.emailjs.com/
# Used by scheduled function to send order status update emails
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_SHIPPED_TEMPLATE_ID=your_shipped_template_id_here
EMAILJS_DELIVERED_TEMPLATE_ID=your_delivered_template_id_here
