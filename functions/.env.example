# Stripe Configuration for Local Development
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp functions/.env.example functions/.env
# 2. Replace the placeholder values below with your TEST keys from Stripe Dashboard
# 3. Never commit functions/.env to git (it's gitignored for security)
#
# For production deployment:
# - Use Firebase secrets instead of .env file
# - Set secrets with: firebase functions:secrets:set STRIPE_SECRET_KEY
# - Set secrets with: firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Stripe Secret Key (use TEST key: sk_test_...)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (use TEST secret: whsec_...)
# Get from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Notion Configuration
# Get from: https://www.notion.so/my-integrations
# 1. Create an internal integration and copy the token (starts with secret_)
# 2. Share your databases with the integration
# 3. Copy the database IDs from the database URLs (32-character strings)
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_ONLINE_ORDERS_DATABASE_ID=your_orders_database_id_here
NOTION_INVENTORY_DATABASE_ID=your_inventory_database_id_here
NOTION_DISCOUNT_CODES_DATABASE_ID=your_discount_codes_database_id_here
NOTION_ALL_EVENTS_DATABASE_ID=your_roast_dates_database_id_here

# Pictify receipt PDF generation
PICTIFY_API_KEY=your_pictify_api_key_here
PICTIFY_RECEIPT_TEMPLATE_UID=your_pictify_receipt_template_uid_here
PICTIFY_RECEIPT_WIDTH=1624
PICTIFY_RECEIPT_HEIGHT=2436

# EmailJS Configuration for Automated Notifications
# Get from: https://dashboard.emailjs.com/
# Used by scheduled function to send order status update emails
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
EMAILJS_CUSTOMER_TEMPLATE_ID=your_emailjs_customer_confirmation_template_id_here
EMAILJS_PURCHASE_TEMPLATE_ID=your_emailjs_purchase_notification_template_id_here
EMAILJS_SHIPPED_TEMPLATE_ID=your_shipped_template_id_here
EMAILJS_DELIVERED_TEMPLATE_ID=your_delivered_template_id_here
EMAILJS_READY_FOR_PICKUP_TEMPLATE_ID=your_ready_for_pickup_template_id_here
EMAILJS_PICKED_UP_TEMPLATE_ID=your_picked_up_template_id_here

# EasyPost Configuration for Shipping
# Get from: https://dashboard.easypost.com/
# 1. Sign up for an EasyPost account
# 2. Navigate to API Keys in the dashboard
# 3. Copy your API key (use TEST key for development: EZAK_test_...)
EASYPOST_API_KEY=EZAK_test_your_easypost_api_key_here
