rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;  // Public read access for product images
      allow write: if request.auth != null;  // Only authenticated users can write
    }
    // Order receipts and shipping labels are private. Only the Admin SDK
    // (adminApi, after it checks the staff list) can read or write them.
    match /order-documents/{allPaths=**} {
      allow read, write: if false;
    }
    // Keep your existing rules for other paths if any
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
