# Stripe Configuration
# Copy this file to .env and fill in your actual values

# Frontend - Stripe Publishable Key (starts with pk_)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend URL - Firebase Functions
# For local development with emulator: http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/api
# For production: https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api
# Replace YOUR_PROJECT_ID with your actual Firebase project ID
REACT_APP_BACKEND_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/api

# Firebase Functions secrets (set using Firebase CLI):
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# EmailJS Configuration
# Get these from your EmailJS dashboard at https://www.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here

# EmailJS Template IDs
REACT_APP_EMAILJS_TEMPLATE_ID=your_contact_form_template_id_here
REACT_APP_EMAILJS_PURCHASE_TEMPLATE_ID=your_purchase_notification_template_id_here
REACT_APP_EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_confirmation_template_id_here

# Notion Configuration (Backend Only - Set via Firebase Functions)
# These are configured in Firebase Functions, not in the frontend .env
# For local development: Add to functions/.env.local
# For production: Set using Firebase CLI:
#   firebase functions:secrets:set NOTION_TOKEN
#   firebase functions:secrets:set NOTION_ONLINE_ORDERS_DATABASE_ID
